# SEC EDGAR user-agent — required for insider ingest
# Format: "AppName/1.0 contact@example.com"
SEC_USER_AGENT=MegaCapScanner/1.0 your@email.com

# Path to DuckDB file (relative to project root)
DATABASE_URL=data/scanner.duckdb

# Port for the web server (Railway sets this automatically)
PORT=8000

# Anthropic API key for 8-K filing summarization (optional)
ANTHROPIC_API_KEY=your_key_here
